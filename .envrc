# Editable environment settings supported by scripts/apply.sh and validate.sh.
# With direnv: run `direnv allow` after creating or changing this file.
# Without direnv: run `source .envrc` from the repository root.
# Run ./scripts/apply.sh without sudo; it elevates internally after reading
# these settings. Running sudo first may discard the exported variables.

# Flake host to build/apply/validate; apply.sh --host overrides this value.
export HOST=desktop

# Home Manager user to validate (validate.sh only).
export USER_NAME=sinless777

# Maximum number of simultaneous package builds (positive integer).
# Start with 2 for large CUDA/C++ builds; try 4 if resources permit.
export BUILD_MAX_JOBS=4

# CPU cores available to each package build (positive integer).
# Start with 4; jobs multiplied by cores is the approximate CPU budget.
export BUILD_CORES=4

# Actions remain explicit command arguments:
#   ./scripts/apply.sh [switch|test|boot|build] [--host HOST] [--dry-run]
#   ./scripts/validate.sh [--build]
